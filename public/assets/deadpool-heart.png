<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1100" width="100%" height="100%">
  <defs>
    <linearGradient id="redSuitH" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e61c38" />
      <stop offset="50%" stop-color="#c8102e" />
      <stop offset="100%" stop-color="#8a081d" />
    </linearGradient>
    <linearGradient id="darkArmorH" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2a2a2a" />
      <stop offset="100%" stop-color="#111111" />
    </linearGradient>
    <filter id="shadowH" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="15" stdDeviation="12" flood-color="#000000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <g filter="url(#shadowH)">
    <!-- KATANAS BEHIND BACK -->
    <g transform="rotate(-28 300 250)">
      <rect x="285" y="120" width="30" height="220" rx="4" fill="url(#darkArmorH)" stroke="#000" stroke-width="3"/>
      <path d="M 285,140 L 315,160 M 285,170 L 315,190 M 285,200 L 315,220" stroke="#c8102e" stroke-width="4"/>
      <rect x="270" y="340" width="60" height="16" rx="3" fill="#111" stroke="#333" stroke-width="2"/>
    </g>
    <g transform="rotate(28 500 250)">
      <rect x="485" y="120" width="30" height="220" rx="4" fill="url(#darkArmorH)" stroke="#000" stroke-width="3"/>
      <path d="M 485,160 L 515,140 M 485,190 L 515,170 M 485,220 L 515,200" stroke="#c8102e" stroke-width="4"/>
      <rect x="470" y="340" width="60" height="16" rx="3" fill="#111" stroke="#333" stroke-width="2"/>
    </g>

    <!-- SHOULDERS & TORSO BASE -->
    <path d="M 200,480 Q 400,440 600,480 L 670,800 Q 400,850 130,800 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="4"/>
    <path d="M 200,480 Q 280,500 300,680 Q 220,750 150,780 Z" fill="url(#darkArmorH)" />
    <path d="M 600,480 Q 520,500 500,680 Q 580,750 650,780 Z" fill="url(#darkArmorH)" />

    <!-- HEAD (Tilted slightly in love/cute pose) -->
    <g transform="rotate(6 400 260)">
      <path d="M 340,360 Q 400,380 460,360 L 470,450 Q 400,470 330,450 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="3"/>
      
      <!-- Head Contour -->
      <path d="M 290,260 C 290,130 340,110 400,110 C 460,110 510,130 510,260 C 510,360 460,400 400,400 C 340,400 290,360 290,260 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="5"/>
      <path d="M 400,110 L 400,400" stroke="#0a0a0a" stroke-width="4" stroke-dasharray="8,6"/>

      <!-- Eye Patches -->
      <path d="M 388,190 C 320,195 305,250 330,320 C 360,360 388,330 388,330 Z" fill="#0a0a0a" />
      <path d="M 412,190 C 480,195 495,250 470,320 C 440,360 412,330 412,330 Z" fill="#0a0a0a" />

      <!-- Cute Wide Expressive White Eyes (Winking / Heart Expression) -->
      <path d="M 380,245 Q 345,260 330,285 Q 365,295 382,280 Z" fill="#ffffff" stroke="#ddd" stroke-width="2"/>
      <path d="M 420,245 Q 455,260 470,285 Q 435,295 418,280 Z" fill="#ffffff" stroke="#ddd" stroke-width="2"/>
    </g>

    <!-- ARMS FORMING A HEART IN FRONT OF CHEST -->
    <!-- Left Arm -->
    <path d="M 180,500 C 230,490 320,530 360,600 C 340,650 280,630 220,580 L 170,550 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="4"/>
    <!-- Right Arm -->
    <path d="M 620,500 C 570,490 480,530 440,600 C 460,650 520,630 580,580 L 630,550 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="4"/>

    <!-- GLOVED HANDS FORMING HEART SYMBOL AT (400, 590) -->
    <g transform="translate(0, -10)">
      <!-- Left Hand Fingers -->
      <path d="M 360,560 C 375,540 395,545 400,565 C 395,585 375,605 355,620 C 340,600 345,575 360,560 Z" fill="#151515" stroke="#000" stroke-width="3"/>
      <!-- Right Hand Fingers -->
      <path d="M 440,560 C 425,540 405,545 400,565 C 405,585 425,605 445,620 C 460,600 455,575 440,560 Z" fill="#151515" stroke="#000" stroke-width="3"/>
      
      <!-- Glowing Red Heart Outline inside the Hand Gesture -->
      <path d="M 400,568 C 390,550 370,555 370,575 C 370,592 400,610 400,615 C 400,610 430,592 430,575 C 430,555 410,550 400,568 Z" fill="#c8102e" stroke="#ffffff" stroke-width="2"/>
    </g>

    <!-- Belt & Lower Body -->
    <rect x="250" y="750" width="300" height="45" fill="#151515" rx="5" stroke="#000" stroke-width="3"/>
    <circle cx="400" cy="772" r="26" fill="#c8102e" stroke="#111" stroke-width="4"/>
    <rect x="397" y="748" width="6" height="48" fill="#111"/>
    
    <path d="M 260,795 L 240,1050 L 370,1050 L 390,795 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="4"/>
    <path d="M 540,795 L 560,1050 L 430,1050 L 410,795 Z" fill="url(#redSuitH)" stroke="#0a0a0a" stroke-width="4"/>
  </g>
</svg>
